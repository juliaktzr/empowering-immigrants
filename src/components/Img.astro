---
import { IMAGES, type ImageName } from '../data/images';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'width' | 'height'> {
  name: ImageName;
  alt: string;
  sizes?: string;
  eager?: boolean;
}
const { name, alt, sizes = '100vw', eager = false, ...rest } = Astro.props;
const img = IMAGES[name];
const largest = img.widths[img.widths.length - 1];
const srcset = img.widths.map((w) => `/images/${name}-${w}.webp ${Math.min(w, img.width)}w`).join(', ');
---
<img
  src={`/images/${name}-${largest}.webp`}
  srcset={srcset}
  sizes={sizes}
  width={img.width}
  height={img.height}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  {...rest}
/>
