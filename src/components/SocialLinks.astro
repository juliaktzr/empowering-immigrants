---
interface Props { facebook: string; linkedin: string; size?: number; class?: string }
const { facebook, linkedin, size = 20, class: className } = Astro.props;
---
<ul class:list={['social', className]}>
  <li>
    <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook (opens in a new tab)">
      <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21z"/></svg>
    </a>
  </li>
  <li>
    <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
      <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M5 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4M3.3 9h3.4v11H3.3zm5.6 0h3.3v1.5h.1c.5-.9 1.6-1.8 3.3-1.8 3.5 0 4.1 2.3 4.1 5.3v6h-3.4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V20H8.9z"/></svg>
    </a>
  </li>
</ul>
