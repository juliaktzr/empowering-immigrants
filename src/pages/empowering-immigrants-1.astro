---
import Base from '../layouts/Base.astro';
import FeaturePage from '../components/FeaturePage.astro';
---
<Base
  title="EMPOWERING IMMIGRANTS | EMPOWERING IMMIGRANTS"
  description="Empowering Immigrants' purpose and goals: enhancing English proficiency for predominantly Spanish-speaking students and helping where schools need it the most."
>
  <FeaturePage>
    <h1 class="section-title">Empowering Immigrants Purpose and Goals</h1>
    <p>Purpose: To enhance the proficiency of the English language to predominantly Spanish-speaking students.</p>
    <h2 class="feature__label">GOALS TO GROW:</h2>
    <p class="feature__tight">To reach out to the community and create awareness and help where schools need it the most.</p>
    <p>To be able to post success stories of how the flash cards helped struggling students gain confidence and speak and write in English with ease.</p>
  </FeaturePage>
</Base>
